# OpenAI
OPENAI_API_KEY=
OPENAI_LEGAL_MODEL=gpt-4.1-mini
# OCR de PDFs escaneados via OpenAI Vision (renderiza el PDF y extrae texto).
# Activado por defecto: si un PDF no tiene texto seleccionable, se intenta OCR
# en vez de rechazarlo. Tiene costo por pagina (acotado por OPENAI_OCR_MAX_PAGES).
OPENAI_PDF_OCR_MODEL=gpt-4o-mini
OPENAI_PDF_OCR_ENABLED=true
OPENAI_OCR_MAX_PAGES=25

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=ace-openai
PINECONE_NAMESPACE=legal-documents
# Namespace AISLADO del archivo administrativo (resoluciones, acuerdos, etc.).
PINECONE_ARCHIVO_NAMESPACE=archivo-municipal
# Namespace AISLADO de la biblioteca de expedientes archivados.
PINECONE_EXPEDIENTES_NAMESPACE=expedientes-archivo

# Reranking de resultados (mejora el orden de relevancia). Reranker dedicado de
# Cohere; si COHERE_API_KEY no esta, se usa el orden heuristico (semantico+lexical+
# jerarquia), que es rapido y razonable. RERANK_ENABLED=false lo desactiva.
RERANK_ENABLED=true
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Proyecto "control" (otra app del usuario) — SOLO LECTURA, para el import de
# "Nueva necesidad" por N de pedido (ver lib/control-supabase.ts). Opcional:
# sin esto, el import por archivo .xlsx del SIGA sigue funcionando igual.
CONTROL_SUPABASE_URL=
CONTROL_SUPABASE_SERVICE_ROLE_KEY=

# Cola de indexacion (drainer por cron en Vercel)
# Secreto que el cron de Vercel envia como "Authorization: Bearer <CRON_SECRET>".
# Genera uno aleatorio y configuralo tambien en las env vars del proyecto en Vercel.
CRON_SECRET=
# Minutos tras los que un documento 'processing' se considera muerto y se re-encola.
INDEXING_STALE_MINUTES=10
# Documentos atascados que procesa cada corrida del drainer.
INDEXING_DRAIN_BATCH=3

# Archivo: activar pgvector solo tras aplicar SQL y completar embeddings.
# Ver docs/supabase/expedientes-pgvector-activacion.md
EXPEDIENTES_VECTOR_READ=pinecone
